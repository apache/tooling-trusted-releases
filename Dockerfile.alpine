FROM python:3.14.5-alpine3.22 AS builder

ENV PIP_DEFAULT_TIMEOUT=100 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_DEV=1 \
    UV_SYSTEM_CERTS=true \
    UV_VERSION=0.13.5

RUN apk update && \
    apk add --no-cache \
      build-base \
      'ca-certificates>=20261020-r0' \
      'ca-certificates-bundle>=20261020-r0' \
      git \
      make \
      patch \
      re2-dev

RUN pip3 install 'pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70'
RUN pip3 install uv==${UV_VERSION}

# use the same workdir as in the final image
# as the created venv will use that path
WORKDIR /opt/atr

# Copy only what we need to install dependencies
COPY Makefile pyproject.toml uv.lock .
COPY scripts/check_pth_files.py scripts/

# only install runtime dependencies
RUN make sync

# Now copy everything else
COPY . .

# generate a version.py module from git information
RUN make generate-version
RUN make build-docs

WORKDIR /opt/atr/.venv/lib/python3.14/site-packages
RUN patch -p2 < /opt/atr/patches/generics.py.patch || :

FROM python:3.14.5-alpine3.22 AS depbuilder

ARG TARGETARCH

RUN apk update && \
    apk add --no-cache \
      'ca-certificates>=20261020-r0' \
      'ca-certificates-bundle>=20261020-r0' \
      curl \
      go \
      icu-libs
RUN [ "$TARGETARCH" != "arm64" ] || apk add --no-cache gcompat

# install additional tools
ENV RAT_VERSION=0.18

RUN set -eux; \
    mkdir -p /opt/tools /tmp/apache-rat; \
    cd /tmp/apache-rat; \
    curl -fsSLO https://dlcdn.apache.org/creadur/apache-rat-${RAT_VERSION}/apache-rat-${RAT_VERSION}-bin.tar.gz; \
    curl -fsSLO https://downloads.apache.org/creadur/apache-rat-${RAT_VERSION}/apache-rat-${RAT_VERSION}-bin.tar.gz.sha512; \
    test "$(sha512sum apache-rat-${RAT_VERSION}-bin.tar.gz | awk '{print $1}')" = \
         "$(cat apache-rat-${RAT_VERSION}-bin.tar.gz.sha512)"; \
    tar -xzf apache-rat-${RAT_VERSION}-bin.tar.gz; \
    find apache-rat-${RAT_VERSION} -type f -name "*.jar" -exec cp {} . \; ; \
    mv apache-rat-${RAT_VERSION}.jar /opt/tools; \
    rm -rf /tmp/apache-rat

# WORKDIR /var/run
ENV SYFT_VERSION=1.55.0
ENV SYFT_INSTALL_SHA256=787fe2aa12311f7dd8e1d9337dfc6e25f091396c958937293a2d3c0eca2ff8ce
ENV SYFT_SHA256_amd64=64c9631c3560336c55c549df0de08cd577d02399c9de807ac390960a4ed5c351
ENV SYFT_SHA256_arm64=4f8068b25551a42991a292a42078519fdc739a97a6f6310e1dcf1367a258c1c2
# RUN GOPATH=/usr/local go install github.com/anchore/syft/cmd/syft@v${SYFT_VERSION}
# Faster than a go-install; the resulting binary is pinned by SHA after install
RUN case "$TARGETARCH" in \
      amd64|"") SYFT_SHA256="$SYFT_SHA256_amd64" ;; \
      arm64) SYFT_SHA256="$SYFT_SHA256_arm64" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    curl -fsSL https://raw.githubusercontent.com/anchore/syft/v${SYFT_VERSION}/install.sh -o /tmp/syft-install.sh && \
    echo "${SYFT_INSTALL_SHA256}  /tmp/syft-install.sh" | sha256sum -c - && \
    DOWNLOAD_TAG_INSTALL_SCRIPT=false sh /tmp/syft-install.sh -b /usr/local/bin "v${SYFT_VERSION}" && \
    echo "${SYFT_SHA256}  /usr/local/bin/syft" | sha256sum -c - && \
    rm -f /tmp/syft-install.sh
ENV SBOMQS_VERSION=2.1.3
RUN GOPATH=/usr/local GOTOOLCHAIN=auto go install github.com/interlynk-io/sbomqs/v2@v${SBOMQS_VERSION}

ENV CDXCLI_VERSION=0.33.1
ENV CDXCLI_ASSET_amd64=cyclonedx-linux-musl-x64
ENV CDXCLI_ASSET_arm64=cyclonedx-linux-arm64
ENV CDXCLI_SHA256_amd64=0095dcfeec6ea1a3f6598d8e0257d52903341d0df21a325fb1510aee7c6b30dd
ENV CDXCLI_SHA256_arm64=b2e9fdf9665ef49868a2ec012171c6e785dcd69745bc5869e53e4f4bfb096a5f
RUN case "$TARGETARCH" in \
      amd64|"") CDXCLI_ASSET="$CDXCLI_ASSET_amd64"; CDXCLI_SHA256="$CDXCLI_SHA256_amd64" ;; \
      arm64) CDXCLI_ASSET="$CDXCLI_ASSET_arm64"; CDXCLI_SHA256="$CDXCLI_SHA256_arm64" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    curl -fsSL https://github.com/CycloneDX/cyclonedx-cli/releases/download/v${CDXCLI_VERSION}/${CDXCLI_ASSET} \
    -o /usr/local/bin/cyclonedx && \
    echo "${CDXCLI_SHA256}  /usr/local/bin/cyclonedx" | sha256sum -c - && \
    chmod +x /usr/local/bin/cyclonedx

# Refuse to build a stage whose syft emits a spec the CLI cannot validate
COPY scripts/ci/check_syft_cli_spec.sh /tmp/check_syft_cli_spec.sh
RUN sh /tmp/check_syft_cli_spec.sh

# final image
FROM python:3.14.5-alpine3.22

ARG TARGETARCH

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Set JAVA_TOOL_OPTIONS to limit memory usage
ENV JAVA_TOOL_OPTIONS="-XX:MaxMetaspaceSize=32m -Xmx128m -XX:+UseSerialGC -XX:MaxRAM=256m -XX:CompressedClassSpaceSize=16m"

# go is required for syft
# openjdk17 is required for Apache RAT
# icu-libs are required for cyclonedx
RUN apk update && \
    apk add --no-cache \
      bash \
      'ca-certificates>=20261020-r0' \
      'ca-certificates-bundle>=20261020-r0' \
      curl \
      file \
      git \
      gpg \
      gpg-agent \
      icu-libs \
      openjdk17 \
      openssl \
      re2 \
      rsync \
      setpriv \
      subversion
RUN [ "$TARGETARCH" != "arm64" ] || apk add --no-cache gcompat

RUN addgroup -g 1000 atr && \
    adduser -u 1000 -G atr -D atr && \
    mkdir -p /opt/atr/state && \
    chown atr:atr /opt/atr/state

COPY --from=depbuilder /usr/local/bin/syft /usr/local/bin/syft
COPY --from=depbuilder /usr/local/bin/sbomqs /usr/local/bin/sbomqs
COPY --from=depbuilder /usr/local/bin/cyclonedx /usr/local/bin/cyclonedx
COPY --from=depbuilder /opt/tools /opt/tools

WORKDIR /opt/atr

# copy app and wheels from builder
COPY --from=builder /opt/atr/.venv ./.venv
COPY --from=builder /opt/atr/atr ./atr
COPY --from=builder /opt/atr/docs ./docs
COPY --from=builder /opt/atr/migrations ./migrations
COPY --from=builder /opt/atr/patches ./patches
COPY --from=builder /opt/atr/scripts ./scripts
COPY --from=builder /opt/atr/Makefile .
COPY --from=builder /opt/atr/alembic.ini .
COPY --from=builder /opt/atr/start-atr.sh .

RUN chmod +x ./start-atr.sh

RUN java -version

RUN cyclonedx --version

EXPOSE 8080

WORKDIR /opt/atr

USER 1000:1000

CMD ["./start-atr.sh"]
